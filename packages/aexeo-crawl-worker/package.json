{
  "name": "@aeptus/aexeo-crawl-worker",
  "version": "0.0.1",
  "private": true,
  "description": "Template Cloudflare Worker that runs the Aexeo WASM evaluator on behalf of the emdash plugin",
  "type": "module",
  "main": "./src/worker.ts",
  "scripts": {
    "build:wasm": "bash ../aexeo-emdash/scripts/build-wasm.sh src/wasm",
    "deploy": "npm run build:wasm && wrangler deploy",
    "dev": "npm run build:wasm && wrangler dev",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240820.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.78.0"
  }
}
