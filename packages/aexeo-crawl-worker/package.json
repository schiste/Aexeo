{
  "name": "@aeptus/aexeo-crawl-worker",
  "version": "0.0.1",
  "private": true,
  "description": "Template Cloudflare Worker that runs the Aexeo WASM evaluator on behalf of the emdash plugin",
  "type": "module",
  "main": "./src/worker.ts",
  "scripts": {
    "build:wasm": "bash ../aexeo-emdash/scripts/build-wasm.sh src/wasm",
    "deploy": "npm run build:wasm && wrangler deploy",
    "dev": "npm run build:wasm && wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/worker.test.mjs",
    "check:dts": "cmp src/wasm/aexeo_emdash_bridge_bg.d.ts ../aexeo-emdash/wasm/aexeo_emdash_bridge_bg.d.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
