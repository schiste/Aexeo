{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-gate.bound-verdict/v2",
  "title": "Draft portable bound verdict (not a publication authorization)",
  "type": "object",
  "required": [
    "schema",
    "binding_profile",
    "binding_sha256",
    "verdict"
  ],
  "properties": {
    "schema": {
      "const": "content-gate.bound-verdict/v2"
    },
    "binding_profile": {
      "const": "content-gate.candidate-binding/v1"
    },
    "binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "verdict": {
      "type": "object",
      "required": [
        "schema",
        "status",
        "subject",
        "validator",
        "evaluated_at",
        "summary",
        "checks",
        "findings"
      ],
      "properties": {
        "schema": {
          "const": "content-gate.verdict/v1"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not_checked",
            "error"
          ]
        },
        "subject": {
          "type": "object",
          "required": [
            "change_id",
            "base",
            "entries"
          ],
          "properties": {
            "change_id": {
              "type": "string",
              "minLength": 1
            },
            "base": {
              "type": "object",
              "required": [
                "kind",
                "revision"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "git",
                    "opaque"
                  ]
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "entries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "entity_id",
                  "sha256"
                ],
                "properties": {
                  "entity_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$",
                        "minLength": 64,
                        "maxLength": 64
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "validator": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "profile_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            }
          },
          "additionalProperties": false
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "object",
          "required": [
            "checks",
            "passed",
            "failed",
            "not_checked",
            "blocking_failed",
            "blocking_not_checked"
          ],
          "properties": {
            "checks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "passed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "not_checked": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "blocking_failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "blocking_not_checked": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          },
          "additionalProperties": false
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status",
              "blocking"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "not_checked"
                ]
              },
              "blocking": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule_id",
              "severity",
              "message"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "error",
                  "warning",
                  "info"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "entity_id": {
                "type": "string",
                "minLength": 1
              },
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "object",
                "required": [
                  "line",
                  "column"
                ],
                "properties": {
                  "line": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 18446744073709551615
                  },
                  "column": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 18446744073709551615
                  }
                },
                "additionalProperties": false
              },
              "subject": {
                "type": "string"
              },
              "suggestion": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "findings_omitted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "extensions": {
          "type": "object",
          "required": [
            "aexeo.offline-input-binding.v1"
          ],
          "properties": {
            "aexeo.offline-input-binding.v1": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "aexeo.html-content-scope.v1": {
              "const": "main"
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "not_checked",
                  "error"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
