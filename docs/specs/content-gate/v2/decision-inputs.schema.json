{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-gate.decision-inputs/v1",
  "title": "Experimental decision-input manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "change", "resolved_policy", "host_options", "evaluator", "collection", "external_evidence"],
  "properties": {
    "schema": {"const": "content-gate.decision-inputs/v1"},
    "change": {"$ref": "#/$defs/present"},
    "resolved_policy": {"$ref": "#/$defs/present"},
    "host_options": {"$ref": "#/$defs/present"},
    "evaluator": {"$ref": "#/$defs/present"},
    "collection": {"$ref": "#/$defs/component"},
    "external_evidence": {"$ref": "#/$defs/component"}
  },
  "$defs": {
    "present": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "sha256"],
      "properties": {"state": {"const": "present"}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}}
    },
    "absent": {
      "type": "object", "additionalProperties": false,
      "required": ["state"], "properties": {"state": {"const": "absent"}}
    },
    "component": {"oneOf": [{"$ref": "#/$defs/present"}, {"$ref": "#/$defs/absent"}]}
  }
}
