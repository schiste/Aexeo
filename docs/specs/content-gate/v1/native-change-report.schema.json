{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aexeo native change report, version 1",
  "description": "An opt-in host observation accompanying a v1 verdict; not an authenticated revision or publication decision.",
  "type": "object",
  "required": ["schema", "verdict", "verdict_sha256", "coverage", "locations"],
  "properties": {
    "schema": { "const": "aexeo.native-change-report/v1" },
    "verdict": { "$ref": "verdict.schema.json" },
    "verdict_sha256": { "$ref": "#/$defs/digest" },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "source_sha256", "source_map_available", "findings", "mapped"],
        "properties": {
          "entity_id": { "type": "string", "minLength": 1 },
          "source_sha256": { "$ref": "#/$defs/digest" },
          "source_map_available": { "type": "boolean" },
          "findings": { "type": "integer", "minimum": 0 },
          "mapped": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "source_sha256", "check_id", "verdict_finding_index", "source", "path", "utf16_offset"],
        "properties": {
          "entity_id": { "type": "string", "minLength": 1 },
          "source_sha256": { "$ref": "#/$defs/digest" },
          "check_id": { "type": "string", "minLength": 1 },
          "verdict_finding_index": { "type": "integer", "minimum": 0 },
          "source": { "const": "host_supplied_native_path" },
          "path": {
            "type": "array", "minItems": 1, "maxItems": 32,
            "items": { "oneOf": [
              { "type": "string", "minLength": 1, "maxLength": 256 },
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
            ] }
          },
          "utf16_offset": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64 }
  }
}
