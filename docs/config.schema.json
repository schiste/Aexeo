{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accessibility": {
      "additionalProperties": false,
      "properties": {
        "strict": {
          "description": "Fire A11Y001 on every image without alt.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "agent_discovery": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "Enable the opt-in AGT rules.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "editorial": {
      "additionalProperties": false,
      "properties": {
        "routes": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "answer_summary_id": {
                "type": "string"
              },
              "claims_requiring_evidence": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "target_questions": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "heading_id": {
                      "type": "string"
                    },
                    "question": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "heading_id",
                    "question"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "description": "Editorial briefs keyed by canonical route path.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "extends": {
      "description": "Parent config file or files merged before the current config.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ]
    },
    "images": {
      "additionalProperties": false,
      "properties": {
        "max_alt_characters": {
          "description": "Advisory maximum length of informative alt text, in characters (IMG006).",
          "minimum": 0,
          "type": "integer"
        },
        "max_bytes": {
          "description": "Advisory maximum encoded size of a local image, in bytes (IMG003).",
          "minimum": 0,
          "type": "integer"
        },
        "prefer_modern_formats": {
          "description": "Suggest WebP or AVIF sources for JPEG and PNG images (IMG005).",
          "type": "boolean"
        },
        "recommend_figure_captions": {
          "description": "Suggest a visible caption for informative images inside a figure (IMG008).",
          "type": "boolean"
        },
        "require_dimensions": {
          "description": "Report images without positive width and height attributes (IMG007).",
          "type": "boolean"
        },
        "require_image_object_metadata": {
          "description": "Opt in: require ImageObject contentUrl, creator and license metadata (IMG010).",
          "type": "boolean"
        },
        "require_image_sitemap": {
          "description": "Opt in: report informative local images missing from the image sitemap (IMG009).",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "max_workers": {
      "description": "Worker count used for parallel analysis tasks.",
      "minimum": 0,
      "type": "integer"
    },
    "output": {
      "additionalProperties": false,
      "properties": {
        "audit_log_limit": {
          "minimum": 0,
          "type": "integer"
        },
        "baseline_file": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "plugin_settings": {
      "additionalProperties": false,
      "description": "Reserved for future plugin-specific settings. No built-in plugins currently publish a registered settings schema.",
      "maxProperties": 0,
      "type": "object"
    },
    "plugins": {
      "description": "Plugins that extend rules or adapters.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "ignore_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ignore_rules": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "route_policy_overrides": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "allow_canonical_noindex": {
                "type": "boolean"
              },
              "allow_nofollow": {
                "type": "boolean"
              },
              "pattern": {
                "type": "string"
              }
            },
            "required": [
              "pattern"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "severity_overrides": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "suppressions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "expires": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "path_pattern": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "rule_id": {
                "type": "string"
              }
            },
            "required": [
              "rule_id",
              "path_pattern",
              "reason"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "profile": {
      "description": "Built-in policy profile.",
      "type": "string"
    },
    "quality": {
      "additionalProperties": false,
      "properties": {
        "performance_budget_file": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "route_kinds": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "match": {
            "description": "Path substrings selecting this route kind.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "noindex": {
            "description": "Accepted, but not read by any rule yet.",
            "type": "boolean"
          },
          "skip_rules": {
            "description": "Rule IDs dropped on matching paths.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "description": "Named route groups whose matching paths skip the listed rules.",
      "type": "object"
    },
    "rules": {
      "additionalProperties": false,
      "properties": {
        "accessibility": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "agent_discovery": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "content": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "min_page_size": {
              "minimum": 0,
              "type": "integer"
            },
            "required_feature_markers": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "editorial": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "headers": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "html": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "require_hreflang_self": {
              "type": "boolean"
            },
            "require_html_lang": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "images": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "links": {
          "additionalProperties": false,
          "properties": {
            "enable_link_autofix": {
              "type": "boolean"
            },
            "enabled": {
              "type": "boolean"
            },
            "link_suggestion_count": {
              "minimum": 0,
              "type": "integer"
            },
            "min_inbound_links": {
              "minimum": 0,
              "type": "integer"
            },
            "orphan_exclude": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "related_links_heading": {
              "type": "string"
            },
            "weak_anchor_text": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "llm": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "robots": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "require_meta_consistency": {
              "type": "boolean"
            },
            "require_sitemap": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "schema": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "require_breadcrumb_schema": {
              "type": "boolean"
            },
            "require_title_alignment": {
              "type": "boolean"
            },
            "required_families": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "required_types": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "sitemap": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "social": {
          "additionalProperties": false,
          "properties": {
            "default_twitter_card": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            },
            "require_open_graph": {
              "type": "boolean"
            },
            "require_social_images": {
              "type": "boolean"
            },
            "require_twitter_card": {
              "type": "boolean"
            },
            "require_twitter_image": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "structure": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "min_answer_blocks": {
              "minimum": 0,
              "type": "integer"
            },
            "min_block_text_length": {
              "minimum": 0,
              "type": "integer"
            },
            "repeatable_data_ui": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "require_fact_consistency": {
              "type": "boolean"
            },
            "utility_route_patterns": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "surfaces": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "well_known": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "runtime": {
      "additionalProperties": false,
      "properties": {
        "allow_private_network": {
          "type": "boolean"
        },
        "artifact_dir": {
          "type": "string"
        },
        "basic_auth": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "capture_console": {
          "type": "boolean"
        },
        "capture_network": {
          "type": "boolean"
        },
        "capture_screenshot": {
          "type": "boolean"
        },
        "capture_trace": {
          "type": "boolean"
        },
        "cookies": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "type": "array"
        },
        "crawl_delay_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "engine": {
          "description": "Default crawl engine.",
          "type": "string"
        },
        "exclude_patterns": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra HTTP headers.",
          "type": "object"
        },
        "ignore_robots": {
          "type": "boolean"
        },
        "include_patterns": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "max_response_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "seeds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "use_sitemap": {
          "type": "boolean"
        },
        "wait_until": {
          "description": "Browser navigation wait strategy.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "site": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "description": "Adapter selection mode.",
          "type": "string"
        },
        "canonical_style": {
          "description": "Preferred internal canonical style.",
          "type": "string"
        },
        "source_dir": {
          "description": "Build-output directory.",
          "type": "string"
        },
        "url": {
          "description": "Canonical base URL.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "version": {
      "const": 1,
      "description": "Canonical nested config surface version.",
      "type": "integer"
    }
  },
  "required": [
    "version"
  ],
  "title": "aexeo configuration",
  "type": "object"
}